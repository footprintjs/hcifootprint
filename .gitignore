node_modules/
dist/
*.log
.DS_Store
.env
# The run's own tally, written by vitest's json reporter for the posttest badge
# gate (scripts/check-test-badge.mjs). Regenerated by every `npm test`.
.test-tally.json
# The coverage report `npm run test:coverage` writes (v8 + an HTML tree for
# every source file). A build artifact of one machine at one moment: committed,
# it starts rotting immediately and every later run shows up as a diff.
coverage/

# Agent worktrees are scratch space, not source.
.claude/worktrees/
