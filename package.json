{
  "name": "hcifootprint",
  "version": "4.1.0",
  "description": "TypeScript action and journey graphs for agent-accessible web apps, with live availability and recorded interaction outcomes.",
  "homepage": "https://footprintjs.github.io/hcifootprint/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footprintjs/hcifootprint.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./webmcp": {
      "types": "./dist/webmcp.d.ts",
      "default": "./dist/webmcp.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./sensor": {
      "types": "./dist/sensor/index.d.ts",
      "default": "./dist/sensor/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/lint": {
      "types": "./dist/testing/lint.d.ts",
      "default": "./dist/testing/lint.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "posttest": "node scripts/check-test-badge.mjs",
    "test:watch": "vitest",
    "demo:chat": "tsx examples/dress-shop/chatbot.ts",
    "example:wizard": "tsx examples/guarded-wizard/run.ts",
    "example:already-true": "tsx examples/already-true/run.ts",
    "docs:api": "node scripts/gen-fumadocs-api.mjs",
    "docs:agents:sync": "node scripts/sync-agent-guide.mjs --write",
    "docs:agents:check": "node scripts/sync-agent-guide.mjs --check",
    "docs:links": "node scripts/check-doc-links.mjs --strict",
    "docs:truth": "node scripts/docs-truth-check.mjs --verbose",
    "docs:truth:check": "node scripts/docs-truth-check.mjs --check",
    "docs:truth:baseline": "node scripts/docs-truth-check.mjs --update-baseline",
    "test:coverage": "vitest run --coverage",
    "bench:tokens": "node bench/token-cost/token-cost.mjs",
    "docs:toolchain:prepare": "patch-package --error-on-fail",
    "docs:toolchain:check": "npm run docs:toolchain:prepare && node --test scripts/typedoc-glob-compat.test.mjs",
    "test:cohort:pins": "node scripts/cohort/check-pins.mjs",
    "test:cohort": "node --test scripts/cohort/*.test.mjs"
  },
  "keywords": [
    "typescript",
    "ai-agent",
    "web-app",
    "actions",
    "journey-graph",
    "interaction-graph",
    "affordance",
    "mcp",
    "webmcp",
    "human-in-the-loop",
    "execution-provenance",
    "footprintjs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "footprintjs": "^11.0.0 || ^12.0.0",
    "foottrace": "^1.11.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.32.0",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": ">=0.110.0 <1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.1",
    "github-slugger": "^2.0.0",
    "gpt-tokenizer": "^3.4.0",
    "patch-package": "8.0.1",
    "react": "^19.2.8",
    "react-test-renderer": "^19.2.8",
    "semver": "^7.8.5",
    "tsx": "^4.22.5",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.5.0",
    "unist-util-visit": "^5.0.0",
    "vite": "8.3.5",
    "vitest": "^4.1.12",
    "zod": "^4.6.6"
  },
  "typesVersions": {
    "*": {
      "mcp": [
        "dist/mcp.d.ts"
      ],
      "webmcp": [
        "dist/webmcp.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ],
      "sensor": [
        "dist/sensor/index.d.ts"
      ],
      "testing": [
        "dist/testing/index.d.ts"
      ],
      "testing/lint": [
        "dist/testing/lint.d.ts"
      ]
    }
  },
  "bugs": {
    "url": "https://github.com/footprintjs/hcifootprint/issues"
  },
  "overrides": {
    "typedoc@0.28.20": {
      "minimatch": "11.0.1"
    }
  },
  "workspaces": [
    "demos/live-desk",
    "demos/onboarding-wizard"
  ]
}
