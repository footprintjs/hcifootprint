{
  "name": "hcifootprint",
  "version": "1.0.0",
  "description": "Turn a web app's interaction surface into a typed, traversable journey graph an LLM can plan over \u2014 the frontend sibling of footprintjs.",
  "homepage": "https://footprintjs.github.io/hcifootprint/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footprintjs/hcifootprint.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./sensor": {
      "types": "./dist/sensor/index.d.ts",
      "default": "./dist/sensor/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/lint": {
      "types": "./dist/testing/lint.d.ts",
      "default": "./dist/testing/lint.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "posttest": "node scripts/check-test-badge.mjs",
    "test:watch": "vitest",
    "demo:chat": "tsx examples/dress-shop/chatbot.ts",
    "example:wizard": "tsx examples/guarded-wizard/run.ts",
    "docs:api": "node scripts/gen-fumadocs-api.mjs",
    "docs:links": "node scripts/check-doc-links.mjs --strict",
    "docs:truth": "node scripts/docs-truth-check.mjs --verbose",
    "docs:truth:check": "node scripts/docs-truth-check.mjs --check",
    "docs:truth:baseline": "node scripts/docs-truth-check.mjs --update-baseline",
    "test:coverage": "vitest run --coverage",
    "bench:tokens": "node bench/token-cost/token-cost.mjs"
  },
  "keywords": [
    "llm",
    "agent",
    "mcp",
    "journey-graph",
    "affordance",
    "interaction-graph",
    "footprintjs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "footprintjs": "^9.10.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": ">=0.110.0 <1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "^0.28.1",
    "github-slugger": "^2.0.0",
    "gpt-tokenizer": "^3.4.0",
    "react": "^19.2.8",
    "react-test-renderer": "^19.2.8",
    "tsx": "^4.22.5",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.5.0",
    "unist-util-visit": "^5.0.0",
    "vitest": "^4.0.0",
    "zod": "^4.0.0"
  },
  "typesVersions": {
    "*": {
      "mcp": [
        "dist/mcp.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ],
      "sensor": [
        "dist/sensor/index.d.ts"
      ],
      "testing": [
        "dist/testing/index.d.ts"
      ],
      "testing/lint": [
        "dist/testing/lint.d.ts"
      ]
    }
  }
}
